DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
STATIC_ROOT=staticfiles
FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

MYSQL_DATABASE=mangalab
MYSQL_USER=mangalab
MYSQL_PASSWORD=replace-this-with-a-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
VIDEO_MAX_UPLOAD_SIZE=524288000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_TRANSCODE_TIMEOUT_SECONDS=21600
# Optional during PostgreSQL-to-MySQL data transfer only:
# POSTGRES_SOURCE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mangalab

CORS_ALLOWED_ORIGINS=https://blixtv.uz,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Cloudflare R2 (leave disabled to keep using local MEDIA_ROOT storage)
R2_STORAGE_ENABLED=False
R2_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=<bucket-name>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<public-bucket-domain>
R2_CDN_BASE_URL=https://cdn.blixtv.uz
